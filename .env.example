# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git — never commit real keys.

# --- Required -----------------------------------------------------------------
# Anthropic API key from https://console.anthropic.com (Settings → API Keys).
# The API is pay-as-you-go and separate from a Claude.ai subscription.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Optional -----------------------------------------------------------------
# Claude model to use. Defaults to claude-sonnet-5-5.
# claude-haiku-5-5 is cheaper and faster.
# AI_MODEL=claude-sonnet-5-5

# LAN address(es) of the computer running the dev server, so phones and other
# devices on your network can open it. Comma-separated, no http:// or port.
# DEV_ORIGINS=192.168.1.50

# Self-hosted Whisper server (OpenAI-compatible API, e.g. speaches) for the
# "Record audio" and "Upload voice memo" options on the Voice Recipe page.
# Leave unset to use only the browser's built-in speech-to-text.
# WHISPER_URL=http://192.168.1.60:8000/v1
# WHISPER_MODEL=Systran/faster-whisper-small
# WHISPER_API_KEY=

# Where saved recipes are stored. Defaults to ./data in the project folder.
# RECIPE_DATA_DIR=./data
